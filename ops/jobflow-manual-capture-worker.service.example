[Unit]
Description=JobFlow manual capture worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=<JOBFLOW_USER>
WorkingDirectory=<JOBFLOW_DIR>
ExecStart=<JOBFLOW_DIR>/ops/manual_capture_worker.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
