# 1. PostgreSQL（必填）
# 请务必替换示例密码。Docker Compose 内部会把应用的主机名覆盖为 postgres。
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=jobflow
POSTGRES_USER=jobflow
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

# 2. FastAPI（可调整）
# 仅本机使用保留 127.0.0.1；需要局域网访问时改为服务器的实际局域网 IP。
API_BIND_HOST=127.0.0.1
API_PORT=8000

# 3. Python 依赖下载（可调整）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_DEFAULT_TIMEOUT=120

# 4. 网络代理（可选，无代理时留空）
# 运行时代理供 API 容器使用；构建代理只供 Docker build 下载依赖。
# 有代理时填写完整地址，例如 http://<PROXY_HOST>:<PROXY_PORT>。
# 使用 compose.proxy.yaml 时，Mihomo 从该目录读取私有配置和 Provider 缓存。
MIHOMO_CONFIG_DIR=./runtime/mihomo
MIHOMO_HOST_PORT=7890
JOBFLOW_HTTP_PROXY=
JOBFLOW_HTTPS_PROXY=
# postgres、localhost 和 127.0.0.1 不经过代理
JOBFLOW_NO_PROXY=postgres,localhost,127.0.0.1
# Linux 服务器通过 compose.proxy.yaml 启动 Mihomo 后，可使用以下构建代理：
JOBFLOW_BUILD_HTTP_PROXY=
JOBFLOW_BUILD_HTTPS_PROXY=
JOBFLOW_BUILD_NO_PROXY=localhost,127.0.0.1
# 如需让每次 docker compose 自动加载服务器代理覆盖，可在私有 .env 中启用：
# COMPOSE_FILE=compose.yaml:compose.proxy.yaml

# 5. OpenAI 模型（可选，只有 mode=ai 需要）
# 直连 OpenAI 时 OPENAI_BASE_URL 可留空；使用兼容接口时填写其 API 基础地址。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 6. Telegram（可选，推送报告时需要）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 7. 报告接口保护（使用报告接口时必填）
# 替换为自己生成的长随机字符串，不要与 Telegram Token 或 OpenAI Key 复用。
REPORT_TRIGGER_TOKEN=replace_with_a_long_random_token

# 8. 微信公众平台（可选，默认关闭）
# 测试号模板与正式公众号草稿使用各自账号的 AppID/AppSecret；不要混用。
# 真实值只填写在部署服务器私有 .env，不要提交到 Git、日志或文档。
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OPENID=
WECHAT_TEMPLATE_ID=
WECHAT_DRAFT_AUTHOR=OpenJobFlow
